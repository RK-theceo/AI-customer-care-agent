# ─────────────────────────────────────────────────────────────────────────────
# AI Phone Call Agent — Environment Variables
# Copy this file to .env and fill in your real values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Twilio ──────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+14155550100          # your Twilio number with country code

# ── Groq (FREE — get key at console.groq.com, no credit card needed) ─────────
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model choice (all free on Groq):
#   llama-3.3-70b-versatile  ← best quality (recommended)
#   llama-3.1-8b-instant     ← fastest response time
#   gemma2-9b-it             ← Google Gemma 2
#   mixtral-8x7b-32768       ← longest context window
GROQ_MODEL=llama-3.3-70b-versatile

# ── Server ───────────────────────────────────────────────────────────────────
# Public HTTPS URL that Twilio can reach.
#   Dev  → paste your ngrok URL:  https://xxxx.ngrok-free.app
#   Prod → your deployed domain:  https://calls.yourcompany.com
BASE_URL=https://xxxx.ngrok-free.app
PORT=5050

# ── Agent persona ─────────────────────────────────────────────────────────────
AGENT_NAME=Aria
BUSINESS_NAME=TechStore India

# ── Voice / speech ────────────────────────────────────────────────────────────
# Twilio voice options (see https://www.twilio.com/docs/voice/twiml/say/text-speech)
#   Polly.Aditi          — Indian English (female, Amazon Polly)
#   Polly.Raveena        — Indian English (female, Amazon Polly)
#   Polly.Matthew        — US English (male, Amazon Polly)
#   Google.en-IN-Standard-A  — Indian English (Google WaveNet)
TTS_VOICE=Polly.Aditi
SPEECH_LANGUAGE=en-IN

# ── Escalation ────────────────────────────────────────────────────────────────
# Phone number to transfer to when Claude decides to escalate.
# Leave blank to play a "we'll call you back" message instead.
ESCALATION_NUMBER=

# ── System prompt (optional override) ────────────────────────────────────────
# Leave blank to use the default prompt in config.py
SYSTEM_PROMPT=
